<script type="text/javascript" src="/js/core.js"></script><script type="text/javascript" src="/js/cartographie/cartographie.js"></script><script type="text/javascript" src="/js/jquery.rating.js"></script><script type="text/javascript" src="/js/jquery.share.js"></script><script type="text/javascript" src="/js/highcharts/highcharts.js"></script><script type="text/javascript" src="/js/highcharts/highcharts-3d.js"></script><script type="text/javascript" src="/js/highcharts/modules/exporting.js"></script><script type="text/javascript" src="/js/openformats.js"></script><script type="text/javascript" src="/js/jquery.masonry.min.js"></script><script type="text/javascript" src="/js/stnav.js"></script><script type="text/javascript">
//<![CDATA[

$(function () {
   

	// Format CSV
	var csvstring= $('#datatable').table2CSV().replace(/\n/gi, ' ').replace(/\s+/gi,' ');
	$('#csv').text(csvstring);
	// Format JSON
	var t = $('#datatable').tableToJSON();
	$('#json').text(JSON.stringify(t));
	// Format XML
	var x = json2xml(t);
	$('#xml').text(x);


	$('.rating > a.rate').click(function(){
		$(this).addClass('note');
		$(this).nextAll('a.rate').addClass("note");
		$(this).prevAll('a.rate').removeClass("note");
		return false;
	});
	
	$('#social').share({
        networks: ['email','pinterest','tumblr','googleplus','digg','facebook','twitter','linkedin','stumbleupon'],
        theme: 'square'
    });

});

//]]>
</script><script type="text/javascript" src="/js/highcharts/opendata.js"></script><script>
