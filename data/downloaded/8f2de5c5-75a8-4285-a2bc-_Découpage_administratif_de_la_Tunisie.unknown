		fillopacity= 0.4,
		randomcolor;
		
message = new Array(); 
message[1]="عدد المعتمديات : ";
message[2]="قائمة المعتمديات : ";

var couleur_de_base='#BD362F',
	taux_de_variation_couleur=80;

for (i = 0; i < tableau.length; i++) {
          
				var message_popup="<strong> اسم الولاية : " +tableau[i][1]+ "<br>"+message[1]+"</strong>"+tableau[i][2]+"<br><strong>"+message[2]+"</strong>"+tableau[i][3];
				var data=tableau[i][0];
				randomcolor=tableau[i][4]/24; 
				var colorstroke=melange_couleur(couleur_de_base, (100* randomcolor),150);
				data.bindPopup(message_popup).setStyle({color: colorstroke, weight: widthstroke, opacity:opacitystroke, fillOpacity: fillopacity}).addTo(map).on('dblclick', function(e) {map.fitBounds(data.getBounds())});	
            }
	
