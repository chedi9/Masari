<script>
function initmap() {
	map = new L.Map('mapOSM');
	var osmUrl='http://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png';
	var osmAttrib='Map data de OpenStreetMap';
	var osm = new L.TileLayer(osmUrl, {minZoom: 2, maxZoom: 10, attribution: osmAttrib});           
	map.setView(new L.LatLng(33.45, 9.33),6);
	map.addLayer(osm);
	map.attributionControl.setPrefix(signature);
	L.control.layers(cartesDeFond).addTo(map);	
}
initmap();

